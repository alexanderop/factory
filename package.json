{
	"name": "factory",
	"type": "module",
	"private": true,
	"license": "Apache-2.0",
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.0.9",
	"scripts": {
		"dev": "pnpm -r --parallel dev",
		"build": "pnpm -r build",
		"check": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run format:check",
		"typecheck": "pnpm -r typecheck",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"devDependencies": {
		"@types/node": "^22.10.10",
		"oxfmt": "^0.48.0",
		"oxlint": "^1.63.0",
		"tsx": "^4.19.2",
		"typescript": "^5.9.2"
	},
	"pnpm": {
		"overrides": {
			"typescript": "5.9.3"
		}
	}
}
