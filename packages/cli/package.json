		"@factory/harness-copilot": "workspace:*",
		"@factory/hooks": "workspace:*",
		"effect": "^3.21.2"
	},
	"devDependencies": {
		"@types/node": "^22.10.10",
		"tsx": "^4.19.2",
		"typescript": "^5.9.2"
